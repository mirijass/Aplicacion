<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <!-- Permite certificados del sistema y certificados de CA instalados por el usuario en el emulador -->
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Configuración específica para el dominio de GestoPago -->
        <domain includeSubdomains="true">portalventas.net</domain>
        <domain includeSubdomains="true">gestopago.com</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>
